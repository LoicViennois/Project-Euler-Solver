{
  "name": "project-euler-solver",
  "version": "2.0.1",
  "description": "Project Euler Solver",
  "license": "GPLv3",
  "author": "Loïc Viennois",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "install:all": "pnpm install && pnpm --dir apps/euler-client install && pnpm --dir apps/euler-server install",
    "start:server": "pnpm --dir apps/euler-server run start:dev",
    "start:client": "pnpm --dir apps/euler-client run start",
    "start": "run-p start:server start:client",
    "release": "standard-version"
  },
  "private": true,
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "standard-version": "^9.5.0"
  }
}
