{
  "name": "project-euler-solver",
  "version": "3.1.0",
  "description": "Project Euler Solver",
  "license": "GPLv3",
  "author": "Loïc Viennois",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "start:server": "pnpm --filter project-euler-server run start:dev",
    "start:client": "pnpm --filter project-euler-client run start",
    "start": "run-p start:server start:client",
    "release": "standard-version"
  },
  "private": true,
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "standard-version": "^9.5.0"
  }
}
